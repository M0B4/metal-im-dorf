---
import { Icon } from "astro-icon/components";
import { SITE_NAME, STUDIO_URL, sitePath, type SiteSettings } from "../utils/site";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
const links = [
  { label: "Historie", href: sitePath("/veranstaltungen#vergangen") },
  { label: "Impressum", href: sitePath("/impressum") },
  { label: "Adminbereich", href: STUDIO_URL },
];
---

<footer class="site-footer">
  <div class="shell--narrow footer-inner">
    {(settings.instagramUrl || settings.facebookUrl) && (
      <div class="footer-socials" aria-label="Social Media">
        {settings.instagramUrl && (
          <a href={settings.instagramUrl} target="_blank" rel="noreferrer" aria-label="Instagram" title="Instagram">
            <Icon name="simple-icons:instagram" size={22} />
          </a>
        )}
        {settings.facebookUrl && (
          <a href={settings.facebookUrl} target="_blank" rel="noreferrer" aria-label="Facebook" title="Facebook">
            <Icon name="simple-icons:facebook" size={22} />
          </a>
        )}
      </div>
    )}

    <a class="footer-mail" href={`mailto:${settings.email}`}>{settings.email}</a>

    <nav class="footer-links" aria-label="Weitere Seiten">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <p class="footer-copy">© {new Date().getFullYear()} {SITE_NAME}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0 2rem;
    background: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-socials {
    display: flex;
    gap: 1.25rem;
  }

  .footer-socials a {
    color: #d4d4d8;
    transition: color 150ms ease;
  }

  .footer-mail,
  .footer-links a {
    color: #a1a1aa;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-socials a:hover,
  .footer-mail:hover,
  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .footer-copy {
    margin: 0.5rem 0 0;
    color: #52525b;
    font-size: 0.78rem;
  }
</style>
