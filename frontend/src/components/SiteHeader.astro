---
import { Icon } from "astro-icon/components";
import { NEW_TAB_HINT, SITE_NAME, sitePath, type SiteSettings } from "../utils/site";

interface Props {
  currentPath: string;
  settings: SiteSettings;
}

const { currentPath, settings } = Astro.props;
const socials = [
  { label: "Instagram", icon: "simple-icons:instagram", href: settings.instagramUrl },
  { label: "Facebook", icon: "simple-icons:facebook", href: settings.facebookUrl },
].filter((social) => social.href);
const navItems = [
  { label: "News", path: "" },
  { label: "Line-Up", path: "/line-up" },
  { label: "Infos", path: "/infos" },
  { label: "Veranstaltungen", path: "/veranstaltungen" },
  { label: "Tickets", path: "/tickets" },
];

// Auf der Startseite zeigt der Hero schon das große Logo: das kleine erst beim Scrollen einblenden.
const homePath = sitePath().replace(/\/$/, "") || "/";
const isHome = currentPath === homePath;

function isActive(path: string) {
  const target = sitePath(path).replace(/\/$/, "") || "/";
  return path ? currentPath === target || currentPath.startsWith(`${target}/`) : isHome;
}
---

<header class="site-header">
  <nav class="shell nav-inner" aria-label="Hauptnavigation">
    <a
      href={sitePath()}
      class:list={["brand", isHome && "brand--deferred"]}
      aria-label={`${SITE_NAME} Startseite`}
    >
      <img src={sitePath("/logo.svg")} alt={SITE_NAME} width="126" height="35" />
    </a>

    <button
      class="nav-toggle"
      id="navToggle"
      type="button"
      aria-label="Hauptmenü öffnen"
      aria-expanded="false"
      aria-controls="navMenu"
    >
      <span></span><span></span><span></span>
    </button>

    <div class="nav-links" id="navMenu">
      {navItems.map((item) => (
        <a
          href={sitePath(item.path)}
          class:list={["nav-link", isActive(item.path) && "is-active"]}
          aria-current={isActive(item.path) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </div>

    {socials.length > 0 && (
      <div class="nav-socials" role="group" aria-label="Social Media">
        {socials.map((social) => (
          <a href={social.href} target="_blank" rel="noreferrer" aria-label={`${social.label} ${NEW_TAB_HINT}`} title={social.label}>
            <Icon name={social.icon} size={18} />
          </a>
        ))}
      </div>
    )}
  </nav>
  {isHome && <noscript><style>.brand--deferred { opacity: 1 !important; visibility: visible !important; transform: none !important; }</style></noscript>}
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("#navToggle");
  const menu = document.querySelector<HTMLElement>("#navMenu");

  const mobileMenu = window.matchMedia("(max-width: 760px)");
  // Solange das Vollbild-Menü offen ist, bleibt der Rest der Seite für Tastatur und Screenreader gesperrt.
  const background = () =>
    Array.from(document.querySelectorAll<HTMLElement>("body > :not(.site-header), .site-header .brand"));

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("is-open", open);
    toggle?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Hauptmenü schließen" : "Hauptmenü öffnen");
    document.body.classList.toggle("nav-open", open);
    background().forEach((element) => (element.inert = open));
    if (open) menu?.querySelector<HTMLElement>(".nav-link")?.focus();
  };

  // Kleines Logo erst zeigen, wenn das große Hero-Logo aus dem Bild gescrollt ist.
  const deferredBrand = document.querySelector<HTMLElement>(".brand--deferred");
  const heroLogo = document.querySelector<HTMLElement>(".logo-hero-logo");
  const header = document.querySelector<HTMLElement>(".site-header");
  if (deferredBrand && heroLogo && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      ([entry]) => deferredBrand.classList.toggle("is-visible", !entry.isIntersecting),
      { rootMargin: `-${header?.offsetHeight ?? 0}px 0px 0px 0px` },
    );
    observer.observe(heroLogo);
  } else {
    deferredBrand?.classList.add("is-visible");
  }

  const isOpen = () => menu?.classList.contains("is-open") ?? false;

  toggle?.addEventListener("click", () => setOpen(!isOpen()));
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });
  // Tab vom letzten Menüpunkt zurück zum Schließen-Knopf statt ins Leere.
  menu?.addEventListener("keydown", (event) => {
    const links = Array.from(menu.querySelectorAll<HTMLElement>(".nav-link"));
    if (event.key === "Tab" && !event.shiftKey && document.activeElement === links.at(-1) && isOpen()) {
      event.preventDefault();
      toggle?.focus();
    }
  });
  mobileMenu.addEventListener("change", (event) => {
    if (!event.matches && isOpen()) setOpen(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #050505;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-inner {
    display: flex;
    min-height: 4rem;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand--deferred {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 400ms ease, transform 400ms ease, visibility 0s linear 400ms;
  }

  .brand--deferred.is-visible {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition: opacity 400ms ease, transform 400ms ease, visibility 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand--deferred,
    .brand--deferred.is-visible {
      transform: none;
      transition: none;
    }
  }

  .brand img {
    width: auto;
    height: 2.2rem;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-left: auto;
  }

  .nav-socials {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-right: -0.5rem;
  }

  .nav-socials a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: #a1a1aa;
    transition: color 150ms ease;
  }

  .nav-socials a:hover {
    color: var(--color-accent);
  }

  .nav-link {
    color: #d4d4d8;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 150ms ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-accent);
  }

  .nav-toggle {
    position: relative;
    z-index: 60;
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0;
    cursor: pointer;
    background: transparent;
    border: 0;
  }

  .nav-toggle span {
    display: block;
    width: 1.6rem;
    height: 2px;
    margin: 3.5px 0;
    background: #fff;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .nav-toggle.is-open span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .nav-toggle.is-open span:nth-child(2) { opacity: 0; }
  .nav-toggle.is-open span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  @media (max-width: 760px) {
    .nav-inner {
      gap: 0.5rem;
    }

    .nav-socials {
      margin-left: auto;
      margin-right: 0;
    }

    .nav-toggle {
      display: flex;
      margin-left: auto;
    }

    .nav-toggle {
      order: 1;
    }

    .nav-inner:has(.nav-socials) .nav-toggle {
      margin-left: 0;
    }

    .nav-links {
      position: fixed;
      inset: 0;
      z-index: 50;
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 1.75rem;
      background: rgba(5, 5, 5, 0.98);
    }

    .nav-links.is-open {
      display: flex;
    }

    .nav-link {
      font-size: 2.25rem;
    }
  }

  :global(body.nav-open) {
    overflow: hidden;
  }
</style>
