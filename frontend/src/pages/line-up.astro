---
import Layout from "../layouts/Layout.astro";
import { formatTime } from "../utils/format";
import { Globe } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import { croppedImageUrl, shareImageUrl, srcSet } from "../utils/image";
import { getLineupEvent, getSiteSettings, type Band, type BandLinkKey } from "../utils/sanity";
import { NEW_TAB_HINT } from "../utils/site";

const [event, settings] = await Promise.all([getLineupEvent(), getSiteSettings()]);
const bands: Band[] = (event?.lineup ?? [])
  .filter((slot) => slot.band)
  .map((slot) => ({ ...slot.band!, spielzeit: slot.spielzeit }));
const linkTypes: Array<{ key: BandLinkKey; label: string; icon?: string }> = [
  { key: "website", label: "Website" },
  { key: "facebook", label: "Facebook", icon: "simple-icons:facebook" },
  { key: "instagram", label: "Instagram", icon: "simple-icons:instagram" },
  { key: "spotify", label: "Spotify", icon: "simple-icons:spotify" },
  { key: "bandcamp", label: "Bandcamp", icon: "simple-icons:bandcamp" },
  { key: "youtube", label: "YouTube", icon: "simple-icons:youtube" },
];
const bandLinks = (band: Band) =>
  band.platzhalter ? [] : linkTypes.filter((type) => band.links?.[type.key]).map((type) => ({ ...type, href: band.links![type.key]! }));
---

<Layout title="Line-Up" description={`Die Bands bei ${event?.titel ?? "Metal im Dorf"}.`} image={event?.bild && shareImageUrl(event.bild)} settings={settings}>
  <div class="shell page">
    <header class="page-header">
      <h1 class="page-title">Line-Up</h1>
      {event && <p class="lineup-event">{event.titel}</p>}
    </header>

    {bands.length ? (
      <section class="band-grid" aria-label="Line-Up">
        {bands.map((band) => (
          <article class:list={["band-card panel", band.platzhalter && "band-card--placeholder"]}>
            {!band.platzhalter && band.bild ? (
              <div class="band-image-wrapper">
                <img
                  src={croppedImageUrl(band.bild, 640)}
                  srcset={srcSet(band.bild, [320, 480, 640, 800], true)}
                  sizes="(max-width: 760px) 50vw, (max-width: 1180px) 33vw, 380px"
                  alt={band.name}
                  class="band-image"
                  loading="lazy"
                />
              </div>
            ) : (
              <div class="band-image-wrapper band-placeholder-image">
                <span>{band.platzhalter ? "TBA" : band.name?.slice(0, 2)}</span>
              </div>
            )}

            <div class="band-info">
              <span class="genre-tag">{band.platzhalter ? "Ankündigung folgt" : band.genre || "Metal"}</span>
              <h2>{band.platzhalter ? "Wird noch bekannt gegeben" : band.name}</h2>
              {bandLinks(band).length > 0 && (
                <ul class="band-links" aria-label={`Links zu ${band.name}`}>
                  {bandLinks(band).map((link) => (
                    <li>
                      <a href={link.href} target="_blank" rel="noreferrer" title={link.label} aria-label={`${link.label} ${NEW_TAB_HINT}`}>
                        {link.icon ? <Icon name={link.icon} size={18} /> : <Globe size={18} aria-hidden="true" />}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              {band.spielzeit && <p>{formatTime(band.spielzeit)}</p>}
            </div>
          </article>
        ))}
      </section>
    ) : (
      <p class="placeholder">Das Line-Up wird bald bekanntgegeben.</p>
    )}
  </div>
</Layout>

<style>
  .page {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .page-header {
    max-width: 760px;
  }

  .lineup-event {
    width: fit-content;
    margin: 1rem 0 0;
    padding: 0.25rem 0;
    color: var(--color-accent);
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .band-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .band-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    transition: border-color 180ms ease, transform 180ms ease;
  }

  .band-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 50%, transparent);
    transform: translateY(-2px);
  }

  .band-card--placeholder {
    border-style: dashed;
  }


  .band-image-wrapper {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #050505;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .band-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.08);
    transition: transform 320ms ease, filter 320ms ease;
  }

  .band-card:hover .band-image {
    filter: saturate(1.05) contrast(1.12);
    transform: scale(1.025);
  }

  .band-placeholder-image {
    display: grid;
    place-items: center;
    background-color: #101010;
    background-image: var(--rough-texture-url);
    background-size: 512px 512px;
  }

  .band-placeholder-image span {
    color: rgba(255, 255, 255, 0.52);
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 900;
  }

  .band-info {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
  }

  .genre-tag {
    width: fit-content;
    padding: 0;
    color: #a1a1aa;
    border: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .band-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 0 -0.45rem;
    padding: 0;
    list-style: none;
  }
  .band-links a {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: #a1a1aa;
    transition: color 150ms ease;
  }
  .band-links a:hover {
    color: var(--color-accent);
  }
  .band-card h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    font-weight: 950;
    line-height: 1.04;
  }

  .band-card p {
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .band-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .band-info {
      padding: 0.8rem;
    }
  }
</style>
