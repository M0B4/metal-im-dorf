---
import Layout from "../layouts/Layout.astro";
import { getSiteSettings } from "../utils/sanity";
import { sitePath } from "../utils/site";

const settings = await getSiteSettings();
---

<Layout title="Seite nicht gefunden" settings={settings}>
  <section class="shell error-page">
    <h1 class="page-title">Seite nicht gefunden</h1>
    <p class="page-lede">Diese Seite existiert nicht oder wurde verschoben.</p>
    <a class="metal-button" href={sitePath("/")}>Zur Startseite</a>
  </section>
</Layout>

<style>
  .error-page {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 820px;
  }

  .error-page .metal-button {
    margin-top: 0.75rem;
  }
</style>
