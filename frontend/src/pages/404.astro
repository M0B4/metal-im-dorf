---
import Layout from "../layouts/Layout.astro";
import { getSiteSettings } from "../utils/sanity";
import { sitePath } from "../utils/site";

const settings = await getSiteSettings();
---

<Layout title="Seite nicht gefunden" settings={settings}>
  <section class="shell error-page">
    <p class="error-code" aria-hidden="true">404</p>
    <h1 class="page-title">Hier spielt gerade keine Band</h1>
    <p class="page-lede">
      Diese Seite hat wohl zu hart gemosht und ist verschwunden. Vielleicht findest du hier, was du suchst:
    </p>
    <div class="error-actions">
      <a class="metal-button" href={sitePath("/line-up")}>Line-Up</a>
      <a class="metal-button" href={sitePath("/tickets")}>Tickets</a>
      <a class="error-home" href={sitePath("/")}>Zur Startseite</a>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 820px;
    padding-block: clamp(1rem, 5vw, 3rem);
  }

  .error-code {
    margin: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(6rem, 22vw, 11rem);
    line-height: 0.85;
    -webkit-text-stroke: 2px var(--color-accent);
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.75rem;
  }

  .error-home {
    color: var(--color-text-soft);
    font-weight: 600;
  }

  .error-home:hover {
    color: var(--color-accent);
  }
</style>
