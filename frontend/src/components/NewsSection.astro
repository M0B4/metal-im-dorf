---
import { ChevronDown } from "@lucide/astro";
import MediaLightbox from "./MediaLightbox.astro";
import NewsCard from "./NewsCard.astro";
import { NEWS_BATCH_SIZE } from "../utils/news";
import type { News } from "../utils/sanity";

interface Props {
  news: News[];
}

// Alle News stehen auf der Startseite. Sichtbar sind zuerst NEWS_BATCH_SIZE,
// "Weitere News" blendet jeweils die nächsten ein. Keine Unterseiten.
const { news } = Astro.props;
---

<section id="news" class="shell--narrow news-feed" aria-labelledby="news-title">
  <header class="feed-heading">
    <h2 id="news-title" class="section-title">News</h2>
  </header>

  {news.length > 0 ? (
    <div class="feed-list" id="news-list">
      {news.map((item, index) => (
        <div class="news-item" hidden={index >= NEWS_BATCH_SIZE}>
          <NewsCard item={item} index={index} />
        </div>
      ))}
    </div>
  ) : (
    <p class="placeholder">Noch keine News.</p>
  )}

  {news.length > NEWS_BATCH_SIZE && (
    <div class="feed-more">
      <button type="button" class="feed-more-button" data-news-more data-batch={NEWS_BATCH_SIZE} aria-controls="news-list">
        Weitere News
        <ChevronDown size={18} stroke-width={2.5} aria-hidden="true" />
      </button>
    </div>
  )}

  {news.length > 0 && <MediaLightbox />}
</section>

<script>
  const items = Array.from(document.querySelectorAll<HTMLElement>(".news-item"));
  const moreButton = document.querySelector<HTMLButtonElement>("[data-news-more]");
  const batch = Number(moreButton?.dataset.batch) || 8;

  function showUntil(count: number) {
    items.forEach((item, index) => {
      if (index < count) item.hidden = false;
    });
    if (moreButton && items.every((item) => !item.hidden)) moreButton.parentElement?.remove();
  }

  moreButton?.addEventListener("click", () => {
    const visible = items.filter((item) => !item.hidden).length;
    const firstNew = items[visible];
    showUntil(visible + batch);
    firstNew?.querySelector<HTMLElement>("h3")?.setAttribute("tabindex", "-1");
    firstNew?.querySelector<HTMLElement>("h3")?.focus({ preventScroll: true });
  });

  // Link auf einen bestimmten Beitrag (#news-<id>): einblenden, aufklappen, hinscrollen.
  const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  const targetItem = target?.closest<HTMLElement>(".news-item");
  if (target && targetItem) {
    showUntil(items.indexOf(targetItem) + 1);
    const toggle = target.querySelector<HTMLButtonElement>("[data-news-toggle]");
    const content = document.getElementById(toggle?.getAttribute("aria-controls") || "");
    toggle?.setAttribute("aria-expanded", "true");
    target.classList.add("is-open");
    if (content) content.hidden = false;
    target.scrollIntoView({ block: "start" });
  }
</script>

<style>
  .news-feed {
    padding-top: clamp(2rem, 5vw, 3.5rem);
    scroll-margin-top: 5rem;
  }


  .news-item[hidden] {
    display: none;
  }

  .feed-more {
    display: flex;
    justify-content: center;
    padding-top: 2rem;
  }

  .feed-more-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.4rem;
    color: #fff;
    cursor: pointer;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-subtle);
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  .feed-more-button:hover,
  .feed-more-button:focus-visible {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .placeholder {
    margin-top: 2rem;
  }
</style>
