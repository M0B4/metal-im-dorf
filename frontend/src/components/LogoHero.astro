---
import { formatDate } from "../utils/format";
import type { Veranstaltung } from "../utils/sanity";
import { SITE_NAME, sitePath } from "../utils/site";

interface Props {
  intro: string;
  events: Veranstaltung[];
}

const { intro, events } = Astro.props;
// Laufband: Liste so oft wiederholen, dass eine Hälfte breiter als der Bildschirm ist;
// die zweite Hälfte ist eine Kopie, damit die Schleife ohne Sprung weiterläuft.
const repeats = Math.max(1, Math.ceil(6 / Math.max(events.length, 1)));
const loop = Array.from({ length: repeats }, () => events).flat();
const duration = `${Math.max(20, loop.length * 9)}s`;
---

<section class="logo-hero">
  <div class="logo-hero-content">
    <h1>
      <img class="logo-hero-logo" src={sitePath("/logo.svg")} alt={SITE_NAME} width="560" height="157" fetchpriority="high" />
    </h1>
    {intro && <p>{intro}</p>}
  </div>
</section>

{events.length > 0 && (
  <aside class="event-ticker" aria-label="Kommende Veranstaltungen">
    <span class="event-ticker-label">Kommende Veranstaltungen</span>
    <div class="event-ticker-viewport">
      <div class="event-ticker-track" style={`--ticker-duration: ${duration}`}>
        {[0, 1].map((copy) => (
          <ul class="event-ticker-list" aria-hidden={copy === 1 ? "true" : undefined}>
            {loop.map((event, index) => (
              <li>
                <a
                  href={sitePath("/veranstaltungen")}
                  tabindex={copy === 1 || index >= events.length ? -1 : undefined}
                  aria-hidden={copy === 0 && index >= events.length ? "true" : undefined}
                >
                  <time datetime={event.beginn}>{formatDate(event.beginn)}</time>
                  <strong>{event.titel}</strong>
                  {event.ort && <span>{event.ort}</span>}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </aside>
)}

<style>
  /* Logo-Bereich als eigene Fläche: halbtransparent heller (das Muster scheint durch), Akzent-Schein hinter dem Logo, Akzentlinie unten. */
  .logo-hero {
    position: relative;
    display: grid;
    place-items: center;
    /* Bis direkt unter die Menüleiste ziehen (gleicht den oberen Abstand von <main> aus). */
    margin-top: calc(-1 * clamp(1.25rem, 3vw, 2.5rem));
    padding: clamp(1.75rem, 5vw, 3.5rem) 1rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 70% at 50% 45%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(40, 40, 46, 0.55) 0%, rgba(20, 20, 24, 0.6) 100%);
    border-bottom: 3px solid var(--color-accent);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.55);
  }

  .logo-hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .logo-hero h1 {
    margin: 0;
  }

  .logo-hero-logo {
    display: block;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.7));
    width: min(420px, 72vw);
    height: auto;
  }

  .logo-hero p {
    max-width: 52ch;
    margin: 0;
    color: #e4e4e7;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.6;
  }

  /* Laufband mit allen kommenden Veranstaltungen. Hover/Fokus hält es an, bei „weniger Bewegung“ steht es still. */
  .event-ticker {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: #0c0c0c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .event-ticker-label {
    position: relative;
    z-index: 1;
    display: flex;
    flex: none;
    align-items: center;
    padding: 0.9rem clamp(0.75rem, 3vw, 1.5rem);
    color: var(--color-accent);
    background: #0c0c0c;
    box-shadow: 12px 0 16px -6px #0c0c0c;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .event-ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  .event-ticker-track {
    display: flex;
    width: max-content;
    animation: event-ticker var(--ticker-duration, 30s) linear infinite;
  }

  .event-ticker:hover .event-ticker-track,
  .event-ticker:focus-within .event-ticker-track {
    animation-play-state: paused;
  }

  .event-ticker-list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .event-ticker-list li {
    display: flex;
    align-items: center;
  }

  .event-ticker-list li::after {
    content: "✦";
    color: var(--color-accent);
    font-size: 0.7rem;
  }

  .event-ticker-list a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.9rem 1.5rem;
    color: #f4f4f5;
    text-decoration: none;
    white-space: nowrap;
  }

  .event-ticker-list a:hover strong {
    color: var(--color-accent);
  }

  .event-ticker-list time,
  .event-ticker-list span {
    color: #a1a1aa;
    font-size: 0.9rem;
  }

  .event-ticker-list strong {
    font-weight: 700;
    transition: color 150ms ease;
  }

  @keyframes event-ticker {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-ticker-track {
      animation: none;
    }

    .event-ticker-viewport {
      overflow-x: auto;
    }

    .event-ticker-list[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .event-ticker-label {
      font-size: 0;
    }

    .event-ticker-label::before {
      content: "Termine";
      font-size: 0.95rem;
    }
  }
</style>
