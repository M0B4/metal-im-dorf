---
import { Mail, MapPin, Ticket } from "@lucide/astro";
import MediaLightbox from "../components/MediaLightbox.astro";
import Poster from "../components/Poster.astro";
import Layout from "../layouts/Layout.astro";
import { formatDateRange, formatTime, yearOf } from "../utils/format";
import { imageUrl, shareImageUrl } from "../utils/image";
import { getEvents, getSiteSettings, isPast, nextEvent, ticketLink, type Kategorie } from "../utils/sanity";
import { ADDRESS, mapsUrl, NEW_TAB_HINT, SITE_NAME, siteUrl } from "../utils/site";

const [events, settings] = await Promise.all([getEvents(), getSiteSettings()]);
const upcoming = events.filter((event) => !isPast(event));

const kategorieLabel = (kategorie: Kategorie) =>
  kategorie === "nebenveranstaltung" ? "Nebenveranstaltung" : "Hauptfestival";
const share = nextEvent(events)?.bild;

// Vergangen ist, was laut Datum vorbei ist: neueste zuerst.
const past = events
  .filter((event) => isPast(event))
  .reverse()
  .map((event) => ({
    id: event._id,
    year: yearOf(event.beginn),
    kategorie: event.kategorie,
    title: event.titel,
    image: event.bild,
  }));

// Strukturierte Daten, damit Suchmaschinen die Termine direkt anzeigen können.
const jsonLd = JSON.stringify(
  upcoming.map((event) => ({
    "@context": "https://schema.org",
    "@type": "MusicEvent",
    name: event.titel,
    startDate: event.beginn,
    ...(event.ende && { endDate: event.ende }),
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: event.ort || ADDRESS[0],
      address: event.adresse || ADDRESS[1],
    },
    ...(event.bild && { image: [imageUrl(event.bild, 1200)] }),
    ...(event.kurzbeschreibung && { description: event.kurzbeschreibung }),
    ...(ticketLink(event) && { offers: { "@type": "Offer", url: new URL(ticketLink(event)!.href, siteUrl()).href } }),
    ...(event.einlass && { doorTime: event.einlass }),
    organizer: { "@type": "Organization", name: SITE_NAME, url: siteUrl() },
    url: siteUrl("/veranstaltungen"),
  })),
).replace(/</g, "\\u003c");
---

<Layout title="Veranstaltungen" description="Kommende und vergangene Veranstaltungen von Metal im Dorf." image={share && shareImageUrl(share)} settings={settings}>
  {upcoming.length > 0 && <script is:inline slot="head" type="application/ld+json" set:html={jsonLd} />}
  <h1 class="sr-only">Veranstaltungen</h1>
  <div class="shell events-page">
    <section id="kommend" aria-labelledby="upcoming-title">
      <h2 id="upcoming-title" class="section-title">Kommende Veranstaltungen</h2>

      {upcoming.length ? (
        <div class="upcoming-list">
          {upcoming.map((event, index) => (
            <article class="upcoming">
              <Poster
                image={event.bild}
                alt={event.bild?.alt || `Plakat ${event.titel}`}
                fallback={String(yearOf(event.beginn))}
                group="kommend"
                sizes="(max-width: 700px) 260px, 300px"
                priority={index === 0}
              />
              <div class="upcoming-info">
                <span class="event-meta">{kategorieLabel(event.kategorie)}</span>
                <h3>{event.titel}</h3>
                <p class="event-date">
                  <time datetime={event.beginn}>{formatDateRange(event.beginn, event.ende)}</time>
                </p>
                <dl class="event-facts">
                  {event.einlass && (
                    <div><dt>Einlass</dt><dd>{formatTime(event.einlass)}</dd></div>
                  )}
                  <div><dt>Beginn</dt><dd>{formatTime(event.beginn)}</dd></div>
                  {event.preis && (
                    <div><dt>Eintritt</dt><dd>{event.preis}</dd></div>
                  )}
                </dl>
                {event.ort && (
                  <a class="event-place" href={mapsUrl(event.ort, event.adresse)} target="_blank" rel="noreferrer">
                    <MapPin size={16} aria-hidden="true" />
                    {[event.ort, event.adresse].filter(Boolean).join(", ")}
                    <span class="sr-only">{NEW_TAB_HINT}</span>
                  </a>
                )}
                {event.kurzbeschreibung && <p class="event-text">{event.kurzbeschreibung}</p>}
                {(() => {
                  const link = ticketLink(event);
                  if (!link) return <p class="box-office"><Ticket size={16} aria-hidden="true" />Tickets nur an der Abendkasse</p>;
                  return link.external ? (
                    <a class="metal-button" href={link.href} target="_blank" rel="noreferrer">
                      <Ticket size={16} aria-hidden="true" />
                      Tickets
                      <span class="sr-only">{NEW_TAB_HINT}</span>
                    </a>
                  ) : (
                    <a class="metal-button" href={link.href}>
                      <Mail size={16} aria-hidden="true" />
                      Tickets bestellen
                    </a>
                  );
                })()}
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="placeholder">Aktuell sind keine Veranstaltungen angekündigt.</p>
      )}
    </section>

    <section id="vergangen" aria-labelledby="past-title">
      <h2 id="past-title" class="section-title">Vergangene Veranstaltungen</h2>

      {past.length ? (
        <>
          <div class="filter" role="group" aria-label="Vergangene Veranstaltungen filtern">
            <button class="filter-button is-active" type="button" data-filter="alle" aria-pressed="true">Alle</button>
            <button class="filter-button" type="button" data-filter="hauptfestival" aria-pressed="false">Hauptfestival</button>
            <button class="filter-button" type="button" data-filter="nebenveranstaltung" aria-pressed="false">Nebenveranstaltungen</button>
          </div>

          <div class="past-grid">
            {past.map((item) => (
              <figure class="past-item" data-category={item.kategorie}>
                <Poster
                  image={item.image}
                  alt={`Plakat ${item.title}`}
                  fallback={String(item.year)}
                  group="vergangen"
                />
                <figcaption>
                  <strong>{item.title}</strong>
                  <span class="event-meta">{item.year}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </>
      ) : (
        <p class="placeholder">Noch keine vergangenen Veranstaltungen.</p>
      )}
    </section>
  </div>

  <MediaLightbox />
</Layout>

<style>
  .events-page {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }

  section {
    display: grid;
    gap: 1.25rem;
    scroll-margin-top: 5rem;
  }

  .section-title {
    margin: 0;
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 3.2rem);
    line-height: 1.05;
  }

  .event-meta {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .upcoming-list {
    display: grid;
    gap: 2rem;
  }

  .upcoming {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: start;
  }

  .upcoming-info {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .upcoming-info h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    line-height: 1;
  }

  .event-date {
    margin: 0;
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .event-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
  }

  .event-facts div {
    display: grid;
    gap: 0.15rem;
  }

  .event-facts dt {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-facts dd {
    margin: 0;
    color: #fff;
    font-weight: 600;
  }

  .box-office {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0.5rem 0 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .event-place {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-soft);
    text-decoration: none;
  }

  .event-place:hover {
    color: var(--color-accent);
  }

  .event-text {
    max-width: 60ch;
    margin: 0;
    color: var(--color-text-soft);
    line-height: 1.65;
  }

  .upcoming-info .metal-button {
    gap: 0.45rem;
    margin-top: 0.5rem;
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-button {
    min-height: 2.6rem;
    padding: 0.6rem 0.9rem;
    color: var(--color-text-soft);
    cursor: pointer;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .filter-button:hover,
  .filter-button.is-active {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .past-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  .past-item {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .past-item[hidden] {
    display: none;
  }

  .past-item figcaption {
    display: grid;
    gap: 0.25rem;
  }

  .past-item strong {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.35rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .past-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .upcoming {
      grid-template-columns: 1fr;
    }

    /* Plakat auf dem Handy etwas kleiner, damit Name, Datum und Tickets schneller zu sehen sind. */
    .upcoming > :global(.poster) {
      width: min(100%, 260px);
    }
  }

  @media (max-width: 480px) {
    .filter-button {
      flex: 1 1 auto;
      padding-inline: 0.6rem;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-button");
  const items = document.querySelectorAll<HTMLElement>(".past-item");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      buttons.forEach((other) => {
        other.classList.toggle("is-active", other === button);
        other.setAttribute("aria-pressed", String(other === button));
      });
      items.forEach((item) => {
        item.hidden = filter !== "alle" && item.dataset.category !== filter;
      });
    });
  });
</script>
