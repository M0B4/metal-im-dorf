---
// Plakat in Originalproportion; Klick öffnet es groß (MediaLightbox).
import { imageUrl, srcSet } from "../utils/image";
import type { SanityImage } from "../utils/sanity";

interface Props {
  image?: SanityImage;
  alt: string;
  /** Ersatztext ohne Plakat, z. B. die Jahreszahl. */
  fallback: string;
  group: string;
  sizes?: string;
}

const { image, alt, fallback, group, sizes = "(max-width: 900px) 50vw, 33vw" } = Astro.props;
---

{image ? (
  <button
    type="button"
    class="poster"
    data-lightbox-group={group}
    data-full-src={imageUrl(image, 2000, 90)}
    data-alt={alt}
    data-caption={alt}
    aria-label={`${alt} vergrößern`}
  >
    <img
      src={imageUrl(image, 720)}
      srcset={srcSet(image, [320, 480, 720, 960])}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      loading="lazy"
    />
  </button>
) : (
  <div class="poster poster--empty" aria-hidden="true">{fallback}</div>
)}

<style>
  .poster {
    display: flex;
    width: 100%;
    aspect-ratio: 3 / 4;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    background: transparent;
    border: 0;
  }

  .poster img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: filter 200ms ease;
  }

  .poster:hover img,
  .poster:focus-visible img {
    filter: contrast(1.08);
  }

  .poster:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .poster--empty {
    cursor: default;
    color: rgba(255, 255, 255, 0.4);
    background-color: #101010;
    background-image: var(--rough-texture-url);
    background-size: 512px 512px;
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
  }
</style>
