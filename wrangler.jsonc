// Cloudflare Workers (statische Website, kein eigener Server-Code).
// Workers Builds führt beim Push `npx wrangler deploy` aus; der Build-Befehl unten erzeugt vorher frontend/dist.
{
  "name": "metal-im-dorf",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build -w frontend" },
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
