---
import { Icon } from "astro-icon/components";
import { formatDateRange } from "../utils/format";
import { getEvents, isPast, ticketLink } from "../utils/sanity";
import { NEW_TAB_HINT, SITE_NAME, STUDIO_URL, sitePath, type SiteSettings } from "../utils/site";

interface Props {
  settings: SiteSettings;
}

const { settings } = Astro.props;
// Jede Seite endet mit einem Hinweis auf das nächste Metal-im-Dorf-Festival.
const festival = (await getEvents()).find((event) => event.kategorie === "hauptfestival" && !isPast(event));
const ticket = festival && ticketLink(festival);
const links = [
  { label: "Impressum", href: sitePath("/impressum") },
  { label: "Datenschutz", href: sitePath("/datenschutz") },
  { label: "Adminbereich", href: STUDIO_URL },
];
---

<footer class="site-footer">
  <div class="shell--narrow footer-inner">
    <a class="footer-logo" href={sitePath()} aria-label={`${SITE_NAME} Startseite`}>
      <img src={sitePath("/logo.svg")} alt="" width="126" height="35" loading="lazy" />
    </a>

    {festival && (
      <p class="footer-next">
        <strong>{festival.titel}</strong>
        <span>{formatDateRange(festival.beginn, festival.ende)}</span>
        {festival.ort && <span>{festival.ort}</span>}
        {ticket && (
          <a href={ticket.href} {...(ticket.external ? { target: "_blank", rel: "noreferrer" } : {})}>
            Tickets{ticket.external && <span class="sr-only"> {NEW_TAB_HINT}</span>}
          </a>
        )}
      </p>
    )}

    {(settings.instagramUrl || settings.facebookUrl) && (
      <div class="footer-socials" role="group" aria-label="Social Media">
        {settings.instagramUrl && (
          <a href={settings.instagramUrl} target="_blank" rel="noreferrer" aria-label={`Instagram ${NEW_TAB_HINT}`} title="Instagram">
            <Icon name="simple-icons:instagram" size={22} />
          </a>
        )}
        {settings.facebookUrl && (
          <a href={settings.facebookUrl} target="_blank" rel="noreferrer" aria-label={`Facebook ${NEW_TAB_HINT}`} title="Facebook">
            <Icon name="simple-icons:facebook" size={22} />
          </a>
        )}
      </div>
    )}

    <a class="footer-mail" href={`mailto:${settings.email}`}>{settings.email}</a>

    <nav class="footer-links" aria-label="Weitere Seiten">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <p class="footer-copy">© {new Date().getFullYear()} {SITE_NAME}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0 2rem;
    background: var(--color-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .footer-logo img {
    display: block;
    width: auto;
    height: 2.4rem;
    opacity: 0.9;
  }

  .footer-next {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.25rem 0.9rem;
    margin: 0 0 0.5rem;
    color: var(--color-text-soft);
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Festivalname in eigener Zeile, darunter Datum · Ort · Tickets. */
  .footer-next strong {
    flex-basis: 100%;
    color: #fff;
    font-weight: 400;
  }

  .footer-next span + span::before,
  .footer-next span + a::before {
    content: "·";
    margin-right: 0.9rem;
    color: var(--color-accent);
  }

  .footer-next a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .footer-next a::before {
    display: inline-block;
    color: var(--color-accent);
  }

  .footer-next a:hover {
    text-decoration: underline;
  }

  .footer-socials {
    display: flex;
    gap: 1.25rem;
  }

  .footer-socials a {
    color: var(--color-text-soft);
    transition: color 150ms ease;
  }

  .footer-mail,
  .footer-links a {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-socials a:hover,
  .footer-mail:hover,
  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
  }

  .footer-copy {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
