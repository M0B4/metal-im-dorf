---
import { MapPin, Ticket } from "@lucide/astro";
import { formatDate, formatDateRange } from "../utils/format";
import { ticketLink, type Veranstaltung } from "../utils/sanity";
import { ADDRESS, mapsUrl, NEW_TAB_HINT, SITE_NAME, sitePath } from "../utils/site";

interface Props {
  intro: string;
  events: Veranstaltung[];
  /** Nächstes Festival: Datum, Ort und Ticket-Button direkt unter dem Logo. */
  next?: Veranstaltung;
}

const { intro, events, next } = Astro.props;
const place = next && (next.ort ? [next.ort, next.adresse] : ADDRESS);
const ticket = next && ticketLink(next);
---

<section class="logo-hero">
  <div class="logo-hero-content">
    <h1>
      <img class="logo-hero-logo" src={sitePath("/logo.svg")} alt={SITE_NAME} width="560" height="157" fetchpriority="high" />
    </h1>
    {intro && <p>{intro}</p>}
    {next && place && (
      <p class="hero-facts">
        <time datetime={next.beginn}>{formatDateRange(next.beginn, next.ende)}</time>
        <a href={mapsUrl(...place)} target="_blank" rel="noreferrer">
          <MapPin size={16} aria-hidden="true" />
          {place[0]}
          <span class="sr-only">{NEW_TAB_HINT}</span>
        </a>
        {ticket ? (
          <a class="hero-ticket" href={ticket.href} {...(ticket.external ? { target: "_blank", rel: "noreferrer" } : {})}>
            <Ticket size={16} aria-hidden="true" />
            Tickets
            {ticket.external && <span class="sr-only">{NEW_TAB_HINT}</span>}
          </a>
        ) : (
          <span class="hero-box-office"><Ticket size={16} aria-hidden="true" />Abendkasse</span>
        )}
      </p>
    )}
  </div>
</section>

{events.length > 0 && (
  <aside class="event-ticker" aria-label="Kommende Veranstaltungen">
    <div class="shell--narrow event-ticker-inner">
      <span class="event-ticker-label">Kommende Veranstaltungen</span>
      <div class="event-ticker-viewport">
        <!-- Jede Veranstaltung genau einmal: die Liste läuft von rechts herein und links hinaus, dann von vorn. -->
        <ul class="event-ticker-list">
          {events.map((event) => (
            <li>
              <a href={sitePath("/veranstaltungen")}>
                <time datetime={event.beginn}>{formatDate(event.beginn)}</time>
                <strong>{event.titel}</strong>
                {event.ort && <span>{event.ort}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </aside>
)}

<script>
  // Gleichmäßiges, ruhiges Tempo unabhängig von der Anzahl der Veranstaltungen (Pixel pro Sekunde).
  const SPEED = 35;
  document.querySelectorAll<HTMLElement>(".event-ticker-list").forEach((list) => {
    const viewport = list.parentElement;
    if (!viewport) return;
    const update = () => {
      const distance = viewport.clientWidth + list.scrollWidth;
      list.style.setProperty("--ticker-from", `${viewport.clientWidth}px`);
      list.style.setProperty("--ticker-duration", `${distance / SPEED}s`);
      // Beim Laden steht die Liste schon links am Anfang, statt erst von rechts hereinzulaufen.
      list.style.setProperty("--ticker-delay", `${-viewport.clientWidth / SPEED}s`);
    };
    update();
    new ResizeObserver(update).observe(viewport);
  });
</script>

<style>
  /* Logo-Bereich als eigene Fläche: halbtransparent heller (das Muster scheint durch), Akzent-Schein hinter dem Logo, Akzentlinie unten. */
  .logo-hero {
    position: relative;
    display: grid;
    place-items: center;
    /* Bis direkt unter die Menüleiste ziehen (gleicht den oberen Abstand von <main> aus). */
    margin-top: calc(-1 * clamp(1.25rem, 3vw, 2.5rem));
    padding: clamp(1.75rem, 5vw, 3.5rem) 1rem;
    overflow: hidden;
    background:
      radial-gradient(ellipse 55% 70% at 50% 45%, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent 70%),
      linear-gradient(180deg, rgba(40, 40, 46, 0.55) 0%, rgba(20, 20, 24, 0.6) 100%);
    border-bottom: 3px solid var(--color-accent);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.55);
  }

  .logo-hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1rem;
    text-align: center;
  }

  .logo-hero h1 {
    margin: 0;
  }

  .logo-hero-logo {
    display: block;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.7));
    width: min(420px, 72vw);
    height: auto;
  }

  .logo-hero p {
    max-width: 52ch;
    margin: 0;
    color: var(--color-text-soft);
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    line-height: 1.6;
  }

  .logo-hero .hero-facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.35rem 1.25rem;
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .hero-facts a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
  }

  .hero-facts a:hover {
    color: var(--color-accent);
  }

  .hero-facts .hero-box-office {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-accent);
  }

  /* Kleiner gefüllter Button in derselben Zeile wie Datum und Ort. */
  .hero-facts .hero-ticket {
    gap: 0.4rem;
    padding: 0.3rem 0.75rem 0.25rem;
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-radius: var(--radius-subtle);
    transition: filter 150ms ease;
  }

  .hero-facts .hero-ticket:hover {
    color: var(--color-accent-contrast);
    filter: brightness(1.15);
  }

  /* Laufband mit allen kommenden Veranstaltungen, so breit wie die News. Hover/Fokus hält es an,
     bei „weniger Bewegung“ steht es still und lässt sich seitlich scrollen. */
  .event-ticker {
    background: #0c0c0c;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .event-ticker-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .event-ticker-label {
    flex: none;
    padding-block: 0.9rem;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .event-ticker-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
  }

  .event-ticker-list {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: event-ticker var(--ticker-duration, 30s) linear var(--ticker-delay, 0s) infinite;
  }

  .event-ticker:hover .event-ticker-list,
  .event-ticker:focus-within .event-ticker-list {
    animation-play-state: paused;
  }

  .event-ticker-list li {
    display: flex;
    align-items: center;
  }

  .event-ticker-list li + li::before {
    content: "✦";
    color: var(--color-accent);
    font-size: 0.7rem;
  }

  .event-ticker-list a {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.9rem 1.25rem;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .event-ticker-list li:first-child a {
    padding-left: 0;
  }

  .event-ticker-list a:hover strong {
    color: var(--color-accent);
  }

  .event-ticker-list time,
  .event-ticker-list span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .event-ticker-list strong {
    font-weight: 700;
    transition: color 150ms ease;
  }

  @keyframes event-ticker {
    from {
      transform: translateX(var(--ticker-from, 100%));
    }

    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-ticker-list {
      animation: none;
    }

    .event-ticker-viewport {
      overflow-x: auto;
      mask-image: none;
    }
  }

  @media (max-width: 600px) {
    .event-ticker-label {
      font-size: 0;
    }

    .event-ticker-label::before {
      content: "Termine";
      font-size: 0.95rem;
    }
  }
</style>
