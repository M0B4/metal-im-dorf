---
import {
  Accessibility,
  CircleParking,
  Info,
  Mail,
  MapPin,
  Route,
  ScrollText,
  ShieldCheck,
  TentTree,
  Ticket,
  Utensils,
  ZoomIn,
} from "@lucide/astro";
import {PortableText} from "astro-portabletext";
import MediaLightbox from "../components/MediaLightbox.astro";
import Layout from "../layouts/Layout.astro";
import {imageUrl, srcSet} from "../utils/image";
import {getEvents, getFestivalInfo, getSiteSettings, isPast} from "../utils/sanity";
import {ADDRESS, mapsUrl, NEW_TAB_HINT, sitePath} from "../utils/site";

const [info, settings, events] = await Promise.all([getFestivalInfo(), getSiteSettings(), getEvents()]);
// Ort und Kartenlink kommen vom Metal-im-Dorf-Hauptfestival (das nächste, sonst das letzte),
// Nebenveranstaltungen zählen hier nicht. Ohne Ort gilt die feste Festivaladresse.
const festivals = events.filter((event) => event.kategorie === "hauptfestival");
const next = festivals.find((event) => !isPast(event)) ?? festivals.at(-1);
const place = next?.ort ? [next.ort, next.adresse].filter((part): part is string => Boolean(part)) : ADDRESS;
const placeUrl = (next?.ort && next.kartenLink) || mapsUrl(...place);
const icons = {
  info: Info,
  route: Route,
  parking: CircleParking,
  camping: TentTree,
  ticket: Ticket,
  food: Utensils,
  rules: ScrollText,
  accessibility: Accessibility,
  safety: ShieldCheck,
  contact: Mail,
};
const resolveLink = (url?: string) => url?.startsWith("/") ? sitePath(url) : url;
// Sprungziel aus der Überschrift, z. B. "Anreise & Gelände" → "anreise-gelaende".
const anchor = (section: { _key: string; title: string }) =>
  section.title
    .toLowerCase()
    .replace(/ä/g, "ae").replace(/ö/g, "oe").replace(/ü/g, "ue").replace(/ß/g, "ss")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "") || section._key;
---

<Layout title={info.title} description={info.intro} settings={settings}>
  <div class="shell--narrow info-page">
    <header class="page-header">
      <h1 class="page-title">{info.title}</h1>
      {info.intro && <p class="page-lede">{info.intro}</p>}
      <a class="info-map" href={placeUrl} target="_blank" rel="noreferrer">
        <MapPin size={18} aria-hidden="true" />
        {place.join(", ")}
        <span class="info-map-hint">In Google Maps öffnen</span>
        <span class="sr-only">{NEW_TAB_HINT}</span>
      </a>
    </header>

    {info.sections.length > 1 && (
      <nav class="info-jump" aria-label="Abschnitte">
        {info.sections.map((section) => (
          <a href={`#${anchor(section)}`}>{section.title}</a>
        ))}
      </nav>
    )}

    <div class="info-sections">
      {info.sections.map((section) => {
        const IconComponent = icons[section.icon as keyof typeof icons] || Info;
        const href = resolveLink(section.linkUrl);
        const images = section.bilder ?? [];
        return (
          <section class="info-section" id={anchor(section)} aria-labelledby={`${anchor(section)}-titel`}>
            <h2 id={`${anchor(section)}-titel`}>
              <IconComponent size={26} stroke-width={1.8} aria-hidden="true" />
              {section.title}
            </h2>
            <div class="info-text prose prose-invert"><PortableText value={section.body} /></div>
            {href && section.linkLabel && <a class="info-link" href={href}>{section.linkLabel}</a>}
            {images.length > 0 && (
              <div class:list={["info-images", images.length === 1 && "info-images--single"]}>
                {images.map((image, index) => {
                  const alt = image.alt || `${section.title} Bild ${index + 1}`;
                  return (
                    <button
                      class="info-image"
                      type="button"
                      data-lightbox-group={`info-${section._key}`}
                      data-full-src={imageUrl(image, 2400, 90)}
                      data-alt={alt}
                      data-caption={alt}
                      aria-label={`${alt} vergrößern`}
                    >
                      <img
                        src={imageUrl(image, 1200)}
                        srcset={srcSet(image, [480, 720, 960, 1200, 1600])}
                        sizes={images.length === 1 ? "(max-width: 900px) calc(100vw - 2rem), 900px" : "(max-width: 700px) calc(100vw - 2rem), 450px"}
                        width={image.width}
                        height={image.height}
                        alt={alt}
                        loading="lazy"
                      />
                      <span class="info-image-hint" aria-hidden="true"><ZoomIn size={16} />Vergrößern</span>
                    </button>
                  );
                })}
              </div>
            )}
          </section>
        );
      })}
    </div>
  </div>

  <MediaLightbox />
</Layout>

<style>
  .info-page {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .page-header {
    max-width: 780px;
  }

  .info-map {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-top: 1rem;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .info-map :global(svg) {
    color: var(--color-accent);
  }
  .info-map-hint {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .info-map:hover .info-map-hint {
    text-decoration: underline;
  }
  /* Sprungmenü zu den Abschnitten */
  .info-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .info-jump a {
    padding: 0.45rem 0.8rem;
    color: var(--color-text-soft);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: var(--radius-subtle);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .info-jump a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* Abschnitte untereinander, Pläne und Bilder groß in voller Breite. */
  .info-sections {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .info-section {
    display: grid;
    gap: 0.9rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid var(--border);
    scroll-margin-top: 5rem;
  }

  .info-section h2 {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    color: #fff;
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    line-height: 1.05;
  }

  .info-section h2 :global(svg) {
    flex: none;
    color: var(--color-accent);
  }

  .info-text {
    max-width: 65ch;
    color: var(--color-text-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  .info-text :global(p) {
    margin: 0 0 0.65rem;
  }

  .info-text :global(p:last-child) {
    margin-bottom: 0;
  }

  .info-link {
    justify-self: start;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .info-link:hover {
    text-decoration: underline;
  }

  .info-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .info-images--single {
    grid-template-columns: 1fr;
  }

  .info-image {
    position: relative;
    display: block;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    background: #0a0a0a;
    border: 1px solid var(--border);
    border-radius: var(--radius-subtle);
    transition: border-color 150ms ease;
  }

  .info-image:hover,
  .info-image:focus-visible {
    border-color: var(--color-accent);
  }

  /* Pläne vollständig zeigen, nicht beschneiden. */
  .info-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .info-image-hint {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    color: #fff;
    background: rgba(5, 5, 5, 0.75);
    border-radius: var(--radius-subtle);
    font-size: 0.8rem;
    font-weight: 600;
  }

  @media (max-width: 700px) {
    .info-images {
      grid-template-columns: 1fr;
    }
  }
</style>
