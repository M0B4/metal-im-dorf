---
import {
  Accessibility,
  CircleParking,
  Info,
  Mail,
  MapPin,
  Route,
  ScrollText,
  ShieldCheck,
  TentTree,
  Ticket,
  Utensils,
} from "@lucide/astro";
import {PortableText} from "astro-portabletext";
import MediaLightbox from "../components/MediaLightbox.astro";
import Layout from "../layouts/Layout.astro";
import {imageUrl, srcSet} from "../utils/image";
import {getFestivalInfo, getSiteSettings} from "../utils/sanity";
import {ADDRESS, mapsUrl, NEW_TAB_HINT, sitePath} from "../utils/site";

const [info, settings] = await Promise.all([getFestivalInfo(), getSiteSettings()]);
const icons = {
  info: Info,
  route: Route,
  parking: CircleParking,
  camping: TentTree,
  ticket: Ticket,
  food: Utensils,
  rules: ScrollText,
  accessibility: Accessibility,
  safety: ShieldCheck,
  contact: Mail,
};
const resolveLink = (url?: string) => url?.startsWith("/") ? sitePath(url) : url;
---

<Layout title={info.title} description={info.intro} settings={settings}>
  <div class="shell info-page">
    <header class="page-header">
      <h1 class="page-title">{info.title}</h1>
      {info.intro && <p class="page-lede">{info.intro}</p>}
      <a class="info-map" href={mapsUrl(...ADDRESS)} target="_blank" rel="noreferrer">
        <MapPin size={18} aria-hidden="true" />
        {ADDRESS.join(", ")}
        <span class="info-map-hint">In Google Maps öffnen</span>
        <span class="sr-only">{NEW_TAB_HINT}</span>
      </a>
    </header>

    <div class="info-grid">
      {info.sections.map((section) => {
        const IconComponent = icons[section.icon as keyof typeof icons] || Info;
        const href = resolveLink(section.linkUrl);
        return (
          <article class="info-card">
            <div class="info-icon"><IconComponent size={24} stroke-width={1.8} aria-hidden="true" /></div>
            <div class="info-copy">
              <h2>{section.title}</h2>
              <div class="prose prose-invert"><PortableText value={section.body} /></div>
              {section.bilder?.length ? (
                <div class="info-images">
                  {section.bilder.map((image, index) => {
                    const alt = image.alt || `${section.title} Bild ${index + 1}`;
                    return (
                      <button
                        class="info-image"
                        type="button"
                        data-lightbox-group={`info-${section._key}`}
                        data-full-src={imageUrl(image, 2000, 90)}
                        data-alt={alt}
                        data-caption={alt}
                        aria-label={`${alt} vergrößern`}
                      >
                        <img
                          src={imageUrl(image, 560)}
                          srcset={srcSet(image, [280, 420, 560, 840])}
                          sizes="(max-width: 760px) calc(50vw - 1.5rem), 260px"
                          width={image.width}
                          height={image.height}
                          alt={alt}
                          loading="lazy"
                        />
                      </button>
                    );
                  })}
                </div>
              ) : null}
              {href && section.linkLabel && <a href={href}>{section.linkLabel}</a>}
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <MediaLightbox />
</Layout>

<style>
  .info-page {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  .page-header {
    max-width: 780px;
  }

  .info-map {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin-top: 1rem;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .info-map :global(svg) {
    color: var(--color-accent);
  }
  .info-map-hint {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .info-map:hover .info-map-hint {
    text-decoration: underline;
  }
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .info-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: start;
    gap: 1rem;
    padding: clamp(1.4rem, 3vw, 2rem) clamp(0rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--border);
  }

  .info-card:nth-child(odd) {
    padding-left: 0;
    padding-right: clamp(1rem, 3vw, 2rem);
  }

  .info-card:nth-child(even) {
    padding-left: clamp(1rem, 3vw, 2rem);
    padding-right: 0;
    border-left: 1px solid var(--border);
  }

  .info-icon {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-accent);
  }

  .info-copy h2 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.1;
  }

  .info-copy .prose {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .info-copy :global(p) {
    margin: 0 0 0.65rem;
  }

  .info-copy :global(p:last-child) {
    margin-bottom: 0;
  }

  .info-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .info-image {
    display: block;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    background: #0a0a0a;
    border: 1px solid var(--border);
    border-radius: var(--radius-subtle);
  }

  .info-image:hover,
  .info-image:focus-visible {
    border-color: var(--color-accent);
  }

  .info-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .info-copy a {
    display: inline-block;
    margin-top: 1rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 900;
    text-decoration: none;
    text-transform: uppercase;
  }

  .info-copy a:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .info-grid {
      grid-template-columns: 1fr;
    }

    .info-card:nth-child(n) {
      padding-inline: 0;
      border-left: 0;
    }
  }

  @media (max-width: 480px) {
    .info-card {
      grid-template-columns: 1fr;
    }
  }
</style>
