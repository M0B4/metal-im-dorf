---
import { ChevronDown } from "@lucide/astro";
import { PortableText } from "astro-portabletext";
import { formatDate } from "../utils/format";
import { imageUrl, srcSet } from "../utils/image";
import { newsAnchor, plainText } from "../utils/news";
import type { News } from "../utils/sanity";

interface Props {
  item: News;
  index: number;
}

const { item, index } = Astro.props;
const text = (item.inhalt ?? []).filter((block) => block._type === "block");
const preview = plainText(text);
const [primaryImage, ...galleryImages] = [...(item.bild ? [item.bild] : []), ...(item.bilder ?? [])];
const anchor = newsAnchor(item);
const lightboxGroup = `news-${item._id}`;
const hasMore = galleryImages.length > 0 || preview.length > 260;
---

<article class:list={["news-post", primaryImage && "news-post--media"]} id={anchor}>
  {primaryImage && (
    <button
      class="news-media"
      type="button"
      data-lightbox-group={lightboxGroup}
      data-full-src={imageUrl(primaryImage, 2000, 90)}
      data-alt={primaryImage.alt || item.titel}
      data-caption={primaryImage.alt || item.titel}
      aria-label={`Bild vergrößern: ${item.titel}`}
    >
      <img
        src={imageUrl(primaryImage, 440)}
        srcset={srcSet(primaryImage, [200, 300, 440, 660])}
        sizes="(max-width: 640px) 100px, 220px"
        width={primaryImage.width}
        height={primaryImage.height}
        alt={primaryImage.alt || item.titel}
        loading={index === 0 ? "eager" : "lazy"}
      />
    </button>
  )}

  <div class="news-body">
  {item.datum && <time class="news-date" datetime={item.datum}>{formatDate(item.datum)}</time>}
  <h3>{item.titel}</h3>

  {hasMore ? (
    <>
      {preview && <p class="news-preview">{preview}</p>}
      <div class="news-full" id={`${anchor}-inhalt`} hidden>
        {text.length > 0 && (
          <div class="news-content prose prose-invert max-w-none">
            <PortableText value={text} />
          </div>
        )}

        {galleryImages.length > 0 && (
          <div class="news-gallery">
            {galleryImages.map((image, imageIndex) => {
              const alt = image.alt || `${item.titel} Bild ${imageIndex + 2}`;
              return (
                <button
                  class="news-gallery-item"
                  type="button"
                  data-lightbox-group={lightboxGroup}
                  data-full-src={imageUrl(image, 2000, 90)}
                  data-alt={alt}
                  data-caption={alt}
                  aria-label={`${alt} vergrößern`}
                >
                  <img
                    src={imageUrl(image, 760)}
                    srcset={srcSet(image, [380, 560, 760])}
                    sizes="(max-width: 640px) 100vw, 380px"
                    width={image.width}
                    height={image.height}
                    alt={alt}
                    loading="lazy"
                  />
                </button>
              );
            })}
          </div>
        )}
      </div>
      <button
        class="news-more"
        type="button"
        aria-expanded="false"
        aria-controls={`${anchor}-inhalt`}
        data-news-toggle
      >
        <span class="news-more-open">Zeige mehr</span>
        <span class="news-more-close">Zeige weniger</span>
        <ChevronDown size={16} stroke-width={2.5} aria-hidden="true" />
      </button>
    </>
  ) : (
    text.length > 0 && (
      <div class="news-content prose prose-invert max-w-none">
        <PortableText value={text} />
      </div>
    )
  )}
  </div>
</article>

<style>
  .news-post {
    display: grid;
    gap: 0.9rem;
    padding-block: clamp(1.75rem, 4vw, 2.75rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    scroll-margin-top: 5rem;
  }

  /* Mit Bild: Bild klein links, Text rechts daneben. */
  .news-post--media {
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 0.9rem clamp(1rem, 3vw, 1.75rem);
    align-items: start;
  }

  .news-body {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  .news-date {
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    line-height: 1.1;
  }

  .news-media,
  .news-gallery-item {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    cursor: zoom-in;
    background: #0a0a0a;
    border: 1px solid transparent;
  }

  .news-media {
    margin-top: 0.3rem;
    border-color: var(--border);
    border-radius: var(--radius-subtle);
  }

  .news-media:hover,
  .news-media:focus-visible,
  .news-gallery-item:hover,
  .news-gallery-item:focus-visible {
    border-color: var(--color-accent);
  }

  .news-media img,
  .news-gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 80vh;
    object-fit: contain;
  }

  .news-preview {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #c4c4cc;
    font-size: 1.02rem;
    line-height: 1.7;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .news-post.is-open .news-preview {
    display: none;
  }

  .news-full {
    display: grid;
    gap: 1rem;
  }

  .news-full[hidden] {
    display: none;
  }

  .news-content {
    color: #d4d4d8;
    font-size: clamp(1rem, 1.5vw, 1.06rem);
    line-height: 1.7;
  }

  .news-content :global(p:first-child) {
    margin-top: 0;
  }

  .news-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .news-content :global(a) {
    color: var(--color-accent);
  }

  .news-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .news-more {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.25rem;
    padding: 0.65rem 1.1rem;
    color: #fff;
    cursor: pointer;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-subtle);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
  }

  .news-more :global(svg) {
    transition: transform 150ms ease;
  }

  .news-more-close,
  .news-more[aria-expanded="true"] .news-more-open {
    display: none;
  }

  .news-more[aria-expanded="true"] .news-more-close {
    display: inline;
  }

  .news-more[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }

  .news-more:hover,
  .news-more:focus-visible {
    color: var(--color-accent-contrast);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .news-post--media {
      grid-template-columns: 100px minmax(0, 1fr);
    }

    .news-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function setNewsOpen(button: HTMLButtonElement, open: boolean) {
    const post = button.closest<HTMLElement>(".news-post");
    const content = document.getElementById(button.getAttribute("aria-controls") || "");
    button.setAttribute("aria-expanded", String(open));
    post?.classList.toggle("is-open", open);
    if (content) content.hidden = !open;
  }

  document.querySelectorAll<HTMLButtonElement>("[data-news-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      setNewsOpen(button, open);
      if (!open) button.closest(".news-post")?.scrollIntoView({ block: "start" });
    });
  });
</script>
